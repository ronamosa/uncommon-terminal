{
    "compilerOptions": {
        "baseUrl": ".",
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "allowJs": true,
        "strict": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "importHelpers": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "inlineSourceMap": true,
        "inlineSources": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
}
