{
    "name": "uncommon-terminal",
    "version": "1.0.0",
    "description": "Run a real shell in an Obsidian pane, rendered by Ghostty's terminal parser.",
    "main": "main.js",
    "type": "commonjs",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint .",
        "test": "tsx --test tests/*.test.ts",
        "check": "npm run lint && npm test && npm run build",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "terminal",
        "ghostty",
        "shell",
        "pty"
    ],
    "author": "Ron Amosa",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ronamosa/uncommon-terminal.git"
    },
    "bugs": {
        "url": "https://github.com/ronamosa/uncommon-terminal/issues"
    },
    "homepage": "https://github.com/ronamosa/uncommon-terminal#readme",
    "dependencies": {
        "ghostty-web": "^0.4.0"
    },
    "devDependencies": {
        "@types/node": "^26",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.1",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "globals": "^17.12.0",
        "obsidian": "latest",
        "tslib": "2.8.1",
        "tsx": "^4.23.13",
        "typescript": "7.0.2",
        "typescript-eslint": "^8.69.0"
    }
}
